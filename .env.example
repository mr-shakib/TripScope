# TripScope configuration. Copy to .env (or run `make env` to generate random local secrets).
# Values marked replace-me are placeholders and must never be used as real credentials.

APP_ENV=development
APP_SECRET_KEY=replace-me
# Comma-separated browser origins allowed to call the API directly (dev server is proxied, so usually empty).
APP_CORS_ORIGINS=

# --- PostgreSQL (application metadata) ---
POSTGRES_USER=tripscope
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tripscope
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- ClickHouse (analytics store) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_HOST_PORT=8123
CLICKHOUSE_DATABASE=tripscope
CLICKHOUSE_ADMIN_PASSWORD=replace-me
# Pipeline writer (DDL/INSERT); never given to the API or AI tools.
CLICKHOUSE_WRITER_USER=tripscope_writer
CLICKHOUSE_WRITER_PASSWORD=replace-me
# Read-only analytics user for the API and AI tools (server-enforced limits).
CLICKHOUSE_READER_USER=tripscope_reader
CLICKHOUSE_READER_PASSWORD=replace-me

# --- Object storage (S3-compatible data lake, SeaweedFS) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_HOST_PORT=8333
S3_BUCKET=tripscope-lake
S3_TEST_BUCKET=tripscope-test
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
# Read-only lake identity used by the ClickHouse server.
S3_CLICKHOUSE_ACCESS_KEY=replace-me
S3_CLICKHOUSE_SECRET_KEY=replace-me

# --- Pipeline ---
PIPELINE_WORK_DIR=./data/work
PIPELINE_MAX_SOURCE_MB=500
SPARK_DRIVER_MEMORY=4g
SPARK_MASTER=local[*]
# Full JDK 17+ for host runs (leave empty to use JAVA_HOME / PATH). Trimmed runtimes lack jdk.incubator.vector.
SPARK_JAVA_HOME=

# --- Analytics limits ---
ANALYTICS_QUERY_TIMEOUT_SECONDS=30
ANALYTICS_MAX_RANGE_DAYS=1100
MAX_EXPORT_ROWS=100000
MAX_UPLOAD_MB=500

# --- AI (Phase 5). disabled | openai_compatible (DeepSeek API or a local Ollama/vLLM/llama.cpp server) ---
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
